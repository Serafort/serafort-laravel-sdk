#!/bin/sh
# Portable pre-commit hook for the Serafort Laravel SDK.
#
# Plain POSIX shell, wired in via `git config core.hooksPath .githooks`.
# Keeps the hook dependency-free and editor/IDE-agnostic.
#
# Enable it once per clone with:
#   git config core.hooksPath .githooks

set -e

echo "[pre-commit] Validating composer.json..."
composer validate --strict

echo "[pre-commit] All checks passed."
