{
  "name": "serafort/laravel",
  "description": "Enterprise IAM, OAuth2/OIDC, Multi-Tenant Isolation, and Wildcard RBAC for Laravel.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Serafort",
      "email": "engineering@serafort.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "illuminate/auth": "^10.0 || ^11.0",
    "illuminate/support": "^10.0 || ^11.0",
    "guzzlehttp/guzzle": "^7.8",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "orchestra/testbench": "^8.0 || ^9.0"
  },
  "autoload": {
    "psr-4": {
      "Serafort\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Serafort\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Serafort\\Laravel\\SerafortServiceProvider"
      ],
      "aliases": {
        "Serafort": "Serafort\\Laravel\\Facades\\Serafort"
      }
    }
  }
}
