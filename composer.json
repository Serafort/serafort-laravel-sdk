{
  "name": "serafort/laravel",
  "description": "Enterprise IAM, OAuth2/OIDC, Multi-Tenant Isolation, and Wildcard RBAC for Laravel.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Serafort",
      "email": "engineering@serafort.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "illuminate/auth": "^10.48.29 || ^11.44.2",
    "illuminate/support": "^10.48.29 || ^11.44.2",
    "guzzlehttp/guzzle": "^7.8",
    "firebase/php-jwt": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "orchestra/testbench": "^8.0 || ^9.0"
  },
  "autoload": {
    "psr-4": {
      "Serafort\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Serafort\\Laravel\\Tests\\": "tests/"
    }
  },
  "config": {
    "policy": {
      "advisories": {
        "ignore-id": [
          "PKSA-3r5d-mb8f-1qw9",
          "PKSA-8qx3-n5y5-vvnd",
          "PKSA-m5cs-t1y6-qpcs",
          "PKSA-mdq4-51ck-6kdq",
          "PKSA-q46n-4fdk-zjr4",
          "PKSA-qzrn-rnz3-85w1",
          "PKSA-w7xr-vk7n-rstm"
        ]
      }
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Serafort\\Laravel\\SerafortServiceProvider"
      ],
      "aliases": {
        "Serafort": "Serafort\\Laravel\\Facades\\Serafort"
      }
    }
  }
}
